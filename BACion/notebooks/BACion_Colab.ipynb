import json
from pathlib import Path

# ============================================================
# CREATE A VALID JUPYTER/GOOGLE COLAB NOTEBOOK
# ============================================================

code = r'''import os
import sys
import json
import shutil
import subprocess
from pathlib import Path

# ============================================================
# BACion
# Prediction of the Optimal NaCl Concentration for Bacterial Growth
# ============================================================

REPO_URL = (
    "https://github.com/"
    "bisalzindal-blip/"
    "Prediction-of-the-Optimal-NaCl-Concentration-for-Bacterial-Growth.git"
)

CLONE_DIR = Path(
    "/content/Prediction-of-the-Optimal-NaCl-Concentration-for-Bacterial-Growth"
)

# Final test-set MAE used only as an approximate error reference.
FINAL_TEST_MAE = 1.3354

print("=" * 70)
print("BACion")
print("Prediction of the Optimal NaCl Concentration for Bacterial Growth")
print("=" * 70)

# ============================================================
# 1. RESET
# ============================================================

os.chdir("/content")

if CLONE_DIR.exists():
    shutil.rmtree(CLONE_DIR)

# ============================================================
# 2. CLONE REPOSITORY
# ============================================================

print("\n[1/8] Cloning BACion repository...")

clone = subprocess.run(
    [
        "git",
        "clone",
        "--depth",
        "1",
        REPO_URL,
        str(CLONE_DIR),
    ],
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
)

if clone.returncode != 0:
    print(clone.stderr)
    raise RuntimeError("Could not clone BACion repository.")

print("Repository cloned successfully.")

# ============================================================
# 3. LOCATE BACion
# ============================================================

print("\n[2/8] Locating BACion package...")

possible_dirs = [
    CLONE_DIR,
    CLONE_DIR / "BACion",
]

BACON_DIR = None

for directory in possible_dirs:
    if (
        (directory / "pyproject.toml").exists()
        and (directory / "model").exists()
        and (directory / "src").exists()
        and (directory / "src" / "bacion").exists()
    ):
        BACON_DIR = directory
        break

if BACON_DIR is None:
    for init_file in CLONE_DIR.rglob("__init__.py"):
        candidate = init_file.parent

        if (
            candidate.name == "bacion"
            and (candidate.parent.parent / "pyproject.toml").exists()
        ):
            BACON_DIR = candidate.parent.parent
            break

if BACON_DIR is None:
    raise FileNotFoundError(
        "Could not locate BACion package directory."
    )

print("BACion directory:")
print(BACON_DIR)

os.chdir(BACON_DIR)

# ============================================================
# 4. CHECK FILES
# ============================================================

print("\n[3/8] Checking BACion files...")

required_files = [
    "README.md",
    "LICENSE.txt",
    "CITATION.cff",
    "pyproject.toml",
    "requirements.txt",
    "model/bacion_xgboost.json",
    "model/feature_config.json",
    "model/feature_names.json",
    "src/bacion/__init__.py",
    "src/bacion/features.py",
    "src/bacion/predictor.py",
]

missing = [
    file
    for file in required_files
    if not Path(file).exists()
]

if missing:
    raise FileNotFoundError(
        "Missing BACion files:\n"
        + "\n".join(missing)
    )

print("BACion repository check: PASSED")

# ============================================================
# 5. INSTALL
# ============================================================

print("\n[4/8] Installing dependencies...")

subprocess.check_call([
    sys.executable,
    "-m",
    "pip",
    "install",
    "-q",
    "-r",
    "requirements.txt",
])

print("Dependencies installed.")

print("\n[5/8] Installing BACion package...")

subprocess.check_call([
    sys.executable,
    "-m",
    "pip",
    "install",
    "-q",
    "-e",
    ".",
])

BACON_SRC = BACON_DIR / "src"

if str(BACON_SRC) not in sys.path:
    sys.path.insert(0, str(BACON_SRC))

# ============================================================
# 6. IMPORT BACion
# ============================================================

import bacion

from bacion import BACionPredictor

print("BACion imported successfully.")
print(
    "BACion version:",
    getattr(bacion, "__version__", "unknown")
)

# ============================================================
# LOAD MODEL
# ============================================================

print("\nLoading BACion prediction model...")

MODEL_PATH = (
    BACON_DIR
    / "model"
    / "bacion_xgboost.json"
)

FEATURE_CONFIG_PATH = (
    BACON_DIR
    / "model"
    / "feature_config.json"
)

FEATURE_NAMES_PATH = (
    BACON_DIR
    / "model"
    / "feature_names.json"
)

predictor = BACionPredictor(
    model_path=str(MODEL_PATH),
    feature_config_path=str(FEATURE_CONFIG_PATH),
    feature_names_path=str(FEATURE_NAMES_PATH),
)

print("BACion XGBoost prediction model loaded successfully.")

# ============================================================
# 7. UPLOAD PROTEOME
# ============================================================

print("\n[6/8] Upload bacterial protein FASTA")
print("-" * 70)
print("Accepted formats: .faa, .fa, .fasta")
print("Recommended input: complete bacterial protein proteome.")
print("-" * 70)

from google.colab import files
from Bio import SeqIO

uploaded = files.upload()

if not uploaded:
    raise RuntimeError("No file uploaded.")

filename, file_bytes = next(iter(uploaded.items()))

input_path = Path("/content") / filename

with open(input_path, "wb") as f:
    f.write(file_bytes)

print(f"\nUploaded: {filename}")

# ============================================================
# VALIDATE FASTA
# ============================================================

print("\nValidating protein FASTA...")

if input_path.suffix.lower() not in {
    ".faa",
    ".fa",
    ".fasta",
}:
    raise ValueError(
        "Invalid file type. "
        "Please upload .faa, .fa, or .fasta."
    )

records = list(
    SeqIO.parse(
        str(input_path),
        "fasta",
    )
)

if not records:
    raise ValueError(
        "The uploaded file does not contain "
        "valid protein FASTA sequences."
    )

lengths = [
    len(str(record.seq).strip())
    for record in records
]

total_residues = sum(lengths)

average_length = (
    total_residues / len(records)
)

print(
    f"Protein sequences: {len(records):,}"
)

print(
    f"Total amino-acid residues: "
    f"{total_residues:,}"
)

print(
    f"Average protein length: "
    f"{average_length:.2f} aa"
)

print("FASTA validation: PASSED")

# ============================================================
# 8. PREDICTION
# ============================================================

print("\n[7/8] Running BACion...")
print("-" * 70)

result = predictor.predict(
    str(input_path)
)

print("Prediction completed successfully.")

predicted_nacl = result.get(
    "predicted_optimal_NaCl_percent"
)

try:
    predicted_nacl = float(predicted_nacl)
except (TypeError, ValueError):
    predicted_nacl = None

# ============================================================
# RESULT
# ============================================================

print("\n")
print("=" * 70)
print("BACion RESULT")
print("=" * 70)

print("\nInput proteome:")
print(f"  {filename}")

print("\nProteins analysed:")
print(f"  {len(records):,}")

print("\nTotal amino-acid residues:")
print(f"  {total_residues:,}")

print("\nAverage protein length:")
print(f"  {average_length:.2f} aa")

print("\nPredicted optimal NaCl concentration:")

if predicted_nacl is not None:
    print(
        f"  {predicted_nacl:.2f}% "
        f"± {FINAL_TEST_MAE:.2f}%"
    )
else:
    print("  Not available")

# ============================================================
# MODEL INFORMATION
# ============================================================

print("\n")
print("=" * 70)
print("BACion MODEL INFORMATION")
print("=" * 70)

print("\nTool:")
print("  BACion")

print("\nVersion:")
print(
    f"  {getattr(bacion, '__version__', 'unknown')}"
)

print("\nPrediction model:")
print("  XGBoost")

print("\nInput type:")
print("  Bacterial protein FASTA")

print("\nPrediction target:")
print(
    "  Optimal NaCl concentration "
    "for bacterial growth"
)

print("\n")
print("NOTE:")

print(
    "The ± value is an approximate error reference "
    "based on the final test-set MAE."
)

print(
    "It is NOT a confidence interval "
    "or prediction interval."
)

print(
    "\nBACion provides a computational prediction."
)

print(
    "Experimental validation is recommended."
)

print("=" * 70)

# ============================================================
# TEXT REPORT
# ============================================================

output_txt = Path(
    "/content/BACion_prediction.txt"
)

with open(
    output_txt,
    "w",
    encoding="utf-8",
) as f:

    f.write("BACion\n")

    f.write(
        "Prediction of the Optimal NaCl "
        "Concentration for Bacterial Growth\n"
    )

    f.write("=" * 70 + "\n\n")

    f.write("INPUT\n")
    f.write("-" * 70 + "\n")

    f.write(
        f"Proteome file: {filename}\n"
    )

    f.write(
        f"Protein sequences analysed: "
        f"{len(records):,}\n"
    )

    f.write(
        f"Total amino-acid residues: "
        f"{total_residues:,}\n"
    )

    f.write(
        f"Average protein length: "
        f"{average_length:.2f} aa\n\n"
    )

    f.write("PREDICTION\n")
    f.write("-" * 70 + "\n")

    if predicted_nacl is not None:

        f.write(
            f"Predicted optimal NaCl concentration: "
            f"{predicted_nacl:.2f}% NaCl\n"
        )

        f.write(
            f"Approximate error reference: "
            f"±{FINAL_TEST_MAE:.2f} percentage points NaCl\n"
        )

    else:

        f.write(
            "Predicted optimal NaCl concentration: "
            "Not available\n"
        )

    f.write("\n")

    f.write("BACion INFORMATION\n")
    f.write("-" * 70 + "\n")

    f.write("Tool: BACion\n")

    f.write(
        f"Version: "
        f"{getattr(bacion, '__version__', 'unknown')}\n"
    )

    f.write("Prediction model: XGBoost\n")

    f.write(
        "Input type: Bacterial protein FASTA\n"
    )

    f.write(
        "Prediction target: Optimal NaCl "
        "concentration for bacterial growth\n\n"
    )

    f.write("FULL MODEL OUTPUT\n")
    f.write("-" * 70 + "\n")

    f.write(
        json.dumps(
            result,
            indent=2,
            default=str,
        )
    )

    f.write("\n\n")

    f.write("NOTE\n")
    f.write("-" * 70 + "\n")

    f.write(
        "BACion provides a computational prediction "
        "of the optimal NaCl concentration for bacterial "
        "growth. Experimental validation is recommended.\n"
    )

print("\nText report created:")
print(output_txt)

print("\nDownloading BACion TXT report...")

files.download(
    str(output_txt)
)

print("\n")
print("=" * 70)
print("BACion analysis completed successfully.")
print("=" * 70)
'''

# ============================================================
# BUILD NOTEBOOK STRUCTURE
# ============================================================

notebook = {
    "cells": [
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "# BACion\n",
                "\n",
                "**Prediction of the Optimal NaCl Concentration for Bacterial Growth**\n",
                "\n",
                "Upload a complete bacterial protein FASTA to predict "
                "the optimal NaCl concentration for bacterial growth."
            ],
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": code.splitlines(True),
        },
    ],
    "metadata": {
        "colab": {
            "name": "BACion_Colab.ipynb",
            "provenance": [],
        },
        "kernelspec": {
            "display_name": "Python 3",
            "name": "python3",
            "language": "python",
        },
        "language_info": {
            "name": "python",
        },
    },
    "nbformat": 4,
    "nbformat_minor": 5,
}

# ============================================================
# SAVE
# ============================================================

output = Path("/content/BACion_Colab.ipynb")

with open(
    output,
    "w",
    encoding="utf-8",
) as f:
    json.dump(
        notebook,
        f,
        indent=2,
        ensure_ascii=False,
    )

# ============================================================
# VALIDATE WITH NBFORMAT
# ============================================================

try:
    import nbformat

    nb = nbformat.read(
        output,
        as_version=4,
    )

    nbformat.validate(nb)

    print("=" * 70)
    print("BACion_Colab.ipynb CREATED SUCCESSFULLY")
    print("=" * 70)
    print(f"File: {output}")
    print(f"Size: {output.stat().st_size / 1024:.1f} KB")
    print("nbformat validation: PASSED")
    print("The notebook is valid JSON and valid Jupyter format.")

except Exception as e:

    print("Notebook validation failed:")
    print(e)
    raise
