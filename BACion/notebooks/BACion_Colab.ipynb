import os
import sys
import json
import shutil
import subprocess
from pathlib import Path

# Configuration
REPO_URL = (
    "https://github.com/"
    "bisalzindal-blip/"
    "Prediction-of-the-Optimal-NaCl-Concentration-for-Bacterial-Growth.git"
)

CLONE_DIR = Path(
    "/content/Prediction-of-the-Optimal-NaCl-Concentration-for-Bacterial-Growth"
)

FINAL_TEST_MAE = 1.3354 # Reference test-set MAE (percentage points NaCl)

print("=" * 70)
print("BACion")
print("Prediction of the Optimal NaCl Concentration for Bacterial Growth")
print("=" * 70)

# Reset working directory
os.chdir("/content")
print("\nWorking directory:", Path.cwd())

# Remove old repository
if CLONE_DIR.exists():
    print("\nRemoving previous repository...")
    shutil.rmtree(CLONE_DIR)

# Clone GitHub repository
print("\n[1/8] Cloning BACion repository...")
clone = subprocess.run(
    [
        "git",
        "clone",
        "--depth",
        "1",
        REPO_URL,
        str(CLONE_DIR),
    ],
    cwd="/content",
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
)

if clone.returncode != 0:
    print("\nGitHub clone failed:")
    print(clone.stderr)
    raise RuntimeError("Could not clone BACion repository.")

print("Repository cloned successfully.")

# Locate BACion directory
print("\n[2/8] Locating BACion package...")

possible_dirs = [
    CLONE_DIR,
    CLONE_DIR / "BACion",
]

BACON_DIR = None

for directory in possible_dirs:
    if (
        (directory / "pyproject.toml").exists()
        and (directory / "model").exists()
        and (directory / "src").exists()
        and (directory / "src" / "bacion").exists()
    ):
        BACON_DIR = directory
        break

# Recursive fallback
if BACON_DIR is None:
    for init_file in CLONE_DIR.rglob("__init__.py"):
        candidate = init_file.parent
        if (
            candidate.name == "bacion"
            and (candidate.parent.parent / "pyproject.toml").exists()
        ):
            BACON_DIR = candidate.parent.parent
            break

if BACON_DIR is None:
    raise FileNotFoundError("Could not locate the BACion package directory.")

print("BACion directory found:")
print(BACON_DIR)

# Enter BACion directory
os.chdir(BACON_DIR)
print("\nWorking directory:")
print(Path.cwd())

# Check required files
print("\n[3/8] Checking BACion files...")

required_files = [
    "README.md",
    "LICENSE.txt",
    "CITATION.cff",
    "pyproject.toml",
    "requirements.txt",
    "model/bacion_xgboost.json",
    "model/feature_config.json",
    "model/feature_names.json",
    "src/bacion/__init__.py",
    "src/bacion/features.py",
    "src/bacion/predictor.py",
]

missing = []

for file in required_files:
    if Path(file).exists():
        print(f"  ✓ {file}")
    else:
        print(f"  ✗ {file}")
        missing.append(file)

if missing:
    raise FileNotFoundError("\nMissing BACion files:\n" + "\n".join(missing))

print("\nBACion repository check: PASSED")

# Install dependencies
print("\n[4/8] Installing dependencies...")
subprocess.check_call(
    [
        sys.executable,
        "-m",
        "pip",
        "install",
        "-q",
        "-r",
        "requirements.txt",
    ]
)
print("Dependencies installed.")

# Install BACion package
print("\n[5/8] Installing BACion package...")
install = subprocess.run(
    [
        sys.executable,
        "-m",
        "pip",
        "install",
        "-q",
        "-e",
        ".",
    ],
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
)

if install.returncode != 0:
    print(install.stderr)
    raise RuntimeError("BACion package installation failed.")

print("pip installation completed.")

# Add src/ to Python path
BACON_SRC = BACON_DIR / "src"
print("\nBACion source directory:")
print(BACON_SRC)

if str(BACON_SRC) not in sys.path:
    sys.path.insert(0, str(BACON_SRC))

# Verify BACion import
print("\nVerifying BACion Python package...")

try:
    import bacion
except ModuleNotFoundError as error:
    print("\nBACion import failed.")
    print("\nPython search paths:")
    for path in sys.path:
        print(" ", path)
    raise error

print("BACion imported successfully.")
print("BACion location:")
print(bacion.__file__)
print("BACion version:", getattr(bacion, "__version__", "unknown"))

# Import predictor
from bacion import BACionPredictor

print("\nBACionPredictor imported successfully.")

# Load model
print("\n[6/8] Loading BACion prediction model...")

MODEL_PATH = BACON_DIR / "model" / "bacion_xgboost.json"
FEATURE_CONFIG_PATH = BACON_DIR / "model" / "feature_config.json"
FEATURE_NAMES_PATH = BACON_DIR / "model" / "feature_names.json"

predictor = BACionPredictor(
    model_path=str(MODEL_PATH),
    feature_config_path=str(FEATURE_CONFIG_PATH),
    feature_names_path=str(FEATURE_NAMES_PATH),
)

print("BACion XGBoost prediction model loaded successfully.")

# Upload proteome
print("\n[7/8] Upload bacterial protein FASTA")
print("-" * 70)
print("Accepted formats: .faa, .fa, .fasta")
print("Recommended input: complete bacterial protein proteome.")
print("-" * 70)

from google.colab import files
from Bio import SeqIO

uploaded = files.upload()

if not uploaded:
    raise RuntimeError("No file uploaded.")

filename, file_bytes = next(iter(uploaded.items()))

# Save uploaded file
input_path = Path("/content") / filename

with open(input_path, "wb") as f:
    f.write(file_bytes)

print(f"\nUploaded: {filename}")
print(f"Saved to: {input_path}")
print(f"Size: {input_path.stat().st_size / (1024 ** 2):.2f} MB")

# Validate FASTA
print("\nValidating protein FASTA...")

valid_extensions = {".faa", ".fa", ".fasta"}

if input_path.suffix.lower() not in valid_extensions:
    raise ValueError("Invalid file type. Please upload .faa, .fa, or .fasta.")

records = list(SeqIO.parse(str(input_path), "fasta"))

if not records:
    raise ValueError(
        "The uploaded file does not contain valid protein FASTA sequences."
    )

lengths = [len(str(record.seq).strip()) for record in records]
total_residues = sum(lengths)
average_length = total_residues / len(records)

print(f"Protein sequences: {len(records):,}")
print(f"Total amino-acid residues: {total_residues:,}")
print(f"Average protein length: {average_length:.2f} aa")
print("FASTA validation: PASSED")

# Run BACion
print("\n[8/8] Running BACion...")
print("-" * 70)

result = predictor.predict(str(input_path))
print("Prediction completed successfully.")

# Get predicted NaCl value
predicted_nacl = result.get("predicted_optimal_NaCl_percent")

try:
    if predicted_nacl is not None:
        predicted_nacl = float(predicted_nacl)
except (TypeError, ValueError):
    pass

# Display result
print("\n")
print("=" * 70)
print("BACion RESULT")
print("=" * 70)

print("\nInput proteome:")
print(f"  {filename}")

print("\nProteins analysed:")
print(f"  {len(records):,}")

print("\nTotal amino-acid residues:")
print(f"  {total_residues:,}")

print("\nAverage protein length:")
print(f"  {average_length:.2f} aa")

print("\nPredicted optimal NaCl concentration:")
if predicted_nacl is not None:
    print(f"  {predicted_nacl:.2f}% ± {FINAL_TEST_MAE:.2f}%")
else:
    print("  Not available")

# Model Information
print("\n")
print("=" * 70)
print("BACion MODEL INFORMATION")
print("=" * 70)

print("\nTool:")
print("  BACion")

print("\nVersion:")
print(f"  {getattr(bacion, '__version__', 'unknown')}")

print("\nPrediction model:")
print("  BACion XGBoost")

print("\nInput type:")
print("  Bacterial protein FASTA")

print("\nPrediction target:")
print("  Optimal NaCl concentration for bacterial growth")

# Note
print("\n")
print("NOTE:")
print(
    "The ± value is an approximate error reference based on the final test-set MAE. "
    "It is NOT a confidence interval or prediction interval."
)
print("\nBACion provides a computational prediction.")
print(
    "Experimental validation is recommended, particularly for individual bacterial strains."
)
print("=" * 70)

# Create text report
output_txt = Path("/content/BACion_prediction.txt")

with open(output_txt, "w", encoding="utf-8") as f:
    f.write("BACion\n")
    f.write("Prediction of the Optimal NaCl Concentration for Bacterial Growth\n")
    f.write("=" * 70 + "\n\n")

    f.write("INPUT\n")
    f.write("-" * 70 + "\n")
    f.write(f"Proteome file: {filename}\n")
    f.write(f"Protein sequences analysed: {len(records):,}\n")
    f.write(f"Total amino-acid residues: {total_residues:,}\n")
    f.write(f"Average protein length: {average_length:.2f} aa\n\n")

    f.write("PREDICTION\n")
    f.write("-" * 70 + "\n")
    if predicted_nacl is not None:
        f.write(
            f"Predicted optimal NaCl concentration: {predicted_nacl:.2f}% NaCl\n"
        )
        f.write(
            f"Approximate error reference: ±{FINAL_TEST_MAE:.2f} percentage points NaCl\n"
        )
    else:
        f.write("Predicted optimal NaCl concentration: Not available\n")
    f.write("\n")

    f.write("BACion INFORMATION\n")
    f.write("-" * 70 + "\n")
    f.write("Tool: BACion\n")
    f.write(f"Version: {getattr(bacion, '__version__', 'unknown')}\n")
    f.write("Prediction model: BACion XGBoost\n")
    f.write("Input type: Bacterial protein FASTA\n")
    f.write(
        "Prediction target: Optimal NaCl concentration for bacterial growth\n\n"
    )


    f.write("FULL MODEL OUTPUT\n")
    f.write("-" * 70 + "\n")
    f.write(json.dumps(result, indent=2, default=str))
    f.write("\n\n")

    f.write("NOTE\n")
    f.write("-" * 70 + "\n")
    f.write(
        "BACion provides a computational prediction of the optimal NaCl concentration for bacterial growth. "
        "Experimental validation is recommended, particularly for individual bacterial strains.\n"
    )

# Download text report
print("\nText report created:")
print(output_txt)

print("\nDownloading BACion TXT report...")
files.download(str(output_txt))

print("\n")
print("=" * 70)
print("BACion analysis completed successfully.")
print("TXT report downloaded.")
print("=" * 70)
